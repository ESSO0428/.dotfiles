#!/usr/bin/env bash
# 管理 ~/.agents/skills.list（要安裝的 skill 清單），並補裝這台缺少的 skill（只補不刪）
#
# 用法：
#   sync-skills            互動模式（終端機 + fzf）：把這台的 skill 加進清單 / 補裝 / 從清單移除
#                          沒有 fzf 或不在終端機時，等同 --install
#   sync-skills --install  補裝清單裡有、這台沒裝的 skill，再把 skill 連到 ~/.claude/skills，
#                          並依 ~/.agents/skills-env.list 用 uv 建好 skill 的 Python 環境
#   sync-skills --diff     只列出差異：清單有但沒裝 / 有裝但不在清單
#   sync-skills --export   用這台的安裝狀態覆寫整份清單（只在主力機上跑，跑完用 git diff 檢查）
#
# 清單格式（# 開頭為註解）：
#   <source>  <skill>
#   mattpocock/skills  grilling
#
# DRY_RUN=1 只印出要執行的指令
set -euo pipefail

LIST="${SKILLS_LIST:-$HOME/.agents/skills.list}"
LOCK="$HOME/.agents/.skill-lock.json"
SKILLS_DIR="$HOME/.agents/skills"
LINKER="$HOME/.agents/scripts/link-claude-skills.sh"
ENV_LIST="${SKILLS_ENV_LIST:-$HOME/.agents/skills-env.list}"
DRY_RUN="${DRY_RUN:-0}"

run() { echo "+ $*"; [ "$DRY_RUN" = 1 ] || "$@"; }

need_list() {
  [ -f "$LIST" ] && return
  echo "找不到清單 $LIST，請先執行 ~/.dotfiles/install.sh agents" >&2
  exit 1
}

# 已安裝的 skill：<source>\t<skill>
installed() {
  [ -f "$LOCK" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.skills | to_entries[] | "\(.value.source)\t\(.key)"' "$LOCK"
  else
    node -e '
      const l = require(process.argv[1]);
      for (const [k, v] of Object.entries(l.skills || {})) console.log(`${v.source}\t${k}`);
    ' "$LOCK"
  fi | sort -u
}

# 清單內容：<source>\t<skill>
wanted() {
  need_list
  sed -e 's/#.*//' "$LIST" | awk 'NF >= 2 { print $1 "\t" $2 }' | sort -u
}

# 清單和這台的對照：<狀態>\t<source>\t<skill>
#   both     清單有、這台也裝了
#   missing  清單有、這台沒裝
#   extra    這台有裝、清單沒有
states() {
  # 每行加上 W（清單）/ I（已安裝）標記再合併；不用 FNR == NR，清單是空的時它會把已安裝的誤當成清單
  { wanted | sed 's/^/W\t/'; installed | sed 's/^/I\t/'; } |
    awk -F'\t' '
      $1 == "W" { w[$3] = $2 }
      $1 == "I" { i[$3] = $2 }
      END {
        for (s in w) print ((s in i) ? "both" : "missing") "\t" w[s] "\t" s
        for (s in i) if (!(s in w)) print "extra\t" i[s] "\t" s
      }' | sort -t$'\t' -k3
}

# 寫回清單：LIST 可能是 stow 建的 symlink，用 cat > 寫回原檔而不是換掉 symlink
write_list() { local tmp; tmp=$(mktemp); cat > "$tmp"; cat "$tmp" > "$LIST"; rm -f "$tmp"; }

# 在一個 skill 目錄內建 uv 環境；$1 是目錄，其餘是 uv sync 的額外參數
setup_env_one() {
  local dir="$1" py="" prev=""; shift
  for a in "$@"; do [ "$prev" = --python ] && py="$a"; prev="$a"; done
  if [ ! -f "$dir/pyproject.toml" ]; then
    [ -f "$dir/requirements.txt" ] || { echo "沒有 pyproject.toml 也沒有 requirements.txt" >&2; return 1; }
    # 沒指定 --python 時 uv init 會拿系統 python（可能太舊）當 requires-python 下限，所以一定要指定
    [ -n "$py" ] || { echo "只有 requirements.txt 的 skill 要在 skills-env.list 指定 --python" >&2; return 1; }
    run uv init -q --bare --no-workspace --python "$py" "$dir" &&
      run uv add -q --project "$dir" --no-sync -r "$dir/requirements.txt" || return 1
  fi
  run uv sync -q --project "$dir" "$@"
}

# 依 skills-env.list 建環境；有裝、帶 Python 依賴、卻沒列入清單的 skill 只提醒
setup_envs() {
  local skill args dir listed=" "
  if [ -f "$ENV_LIST" ]; then
    while read -r skill args; do
      listed+="$skill "
      dir="$SKILLS_DIR/$skill"
      [ -d "$dir" ] || continue
      if ! command -v uv >/dev/null 2>&1; then
        echo "warn: 找不到 uv，略過 $skill 的 Python 環境（裝好 uv 後重跑 sync-skills --install）" >&2
        continue
      fi
      echo "== Python 環境：$skill"
      # shellcheck disable=SC2086  # args 是多個 uv 參數，要拆開
      setup_env_one "$dir" $args || echo "warn: $skill 的 Python 環境建立失敗" >&2
    done < <(sed -e 's/#.*//' "$ENV_LIST" | awk 'NF')
  fi
  for dir in "$SKILLS_DIR"/*/; do
    skill=$(basename "$dir")
    case "$listed" in *" $skill "*) continue ;; esac
    if [ -f "$dir/pyproject.toml" ] || [ -f "$dir/requirements.txt" ]; then
      echo "warn: $skill 帶有 Python 依賴，但不在 $ENV_LIST，沒有建環境" >&2
    fi
  done
}

# 從 stdin 讀 <source>\t<skill>，依來源分組安裝，再重建 ~/.claude/skills 的連結、建 Python 環境
install_entries() {
  local entries src skills s args still
  entries=$(cat)
  while IFS=$'\t' read -r src skills; do
    args=()
    for s in $skills; do args+=(-s "$s"); done
    # 要的 skill 全都不存在時 npx 會失敗；不要讓 set -e 中斷，其他來源、連結、環境照常處理
    run npx -y skills add "$src" -g -y "${args[@]}" || echo "warn: npx skills add $src 失敗" >&2
  done < <(printf '%s\n' "$entries" | awk -F'\t' 'NF >= 2 { a[$1] = a[$1] " " $2 } END { for (k in a) print k "\t" a[k] }')
  # npx skills add 找不到 skill 時不會報錯，只會默默跳過（例如上游已刪除或改名），裝完再對一次
  if [ "$DRY_RUN" != 1 ] && [ -n "$entries" ]; then
    still=$(states | awk -F'\t' '$1 == "missing" { print $3 }' |
      grep -Fxf <(printf '%s\n' "$entries" | cut -f2) || true)
    if [ -n "$still" ]; then
      echo "warn: 下列 skill 裝完仍不存在，上游可能已刪除或改名，請檢查來源後更新清單：" >&2
      printf '  %s\n' $still >&2
    fi
  fi
  # link-claude-skills.sh 自己支援 DRY_RUN
  if [ -f "$LINKER" ]; then
    DRY_RUN="$DRY_RUN" bash "$LINKER"
  fi
  setup_envs
}

cmd_install() {
  local missing
  missing=$(states | awk -F'\t' '$1 == "missing" { print $2 "\t" $3 }')
  if [ -z "$missing" ]; then
    echo "清單裡的 skill 都已安裝"
    install_entries < /dev/null
  else
    printf '%s\n' "$missing" | install_entries
  fi
}

cmd_diff() {
  echo "== 清單有、這台沒裝"
  states | awk -F'\t' '$1 == "missing" { printf "  %-24s %s\n", $2, $3 }'
  echo "== 這台有裝、清單沒有（不會被移除）"
  states | awk -F'\t' '$1 == "extra" { printf "  %-24s %s\n", $2, $3 }'
}

cmd_export() {
  {
    echo "# 要安裝的 skill 清單，由 sync-skills --export 產生（主力機）"
    echo "# 格式：<source>  <skill>"
    installed | awk -F'\t' '{ printf "%-24s %s\n", $1, $2 }'
  } | write_list
  echo "已寫入 $LIST，請到 dotfiles repo 用 git diff 檢查後 commit"
}

# ---------------------------------------------------------------- 互動
# fzf 複選：stdin 是 <狀態>\t<source>\t<skill>，輸出選中的 <source>\t<skill>
pick() {
  local header="$1"
  awk -F'\t' '{ printf "%-24s %-28s\t%s\t%s\n", $2, $3, $2, $3 }' |
    fzf --multi --reverse --height=80% --delimiter=$'\t' --with-nth=1 \
      --prompt="skill> " --header="$header"$'\nTab 勾選（可複選）、Ctrl-A 全選、Enter 確認、Esc 返回' \
      --bind='ctrl-a:select-all' \
      --preview="bash '$0' --preview {3} {2}" \
      --preview-window='right,55%,wrap' |
    awk -F'\t' '{ print $2 "\t" $3 }' || true
}

count() { states | awk -F'\t' -v s="$1" '$1 == s' | wc -l | tr -d ' '; }

interactive() {
  local action chosen
  while true; do
    action=$(printf '%s\n' \
      "add      把這台的 skill 加進清單（這台有、清單沒有：$(count extra) 個）" \
      "install  安裝清單裡這台缺少的 skill（$(count missing) 個）" \
      "remove   從清單移除（清單共 $(( $(count both) + $(count missing) )) 個；已安裝的不會被刪）" \
      "quit     離開" |
      fzf --reverse --height=40% --prompt="sync-skills> " \
        --header="清單：$LIST（改完到 ~/.dotfiles 用 git diff 檢查後 commit）" |
      awk '{ print $1 }') || true

    case "$action" in
      add)
        chosen=$(states | awk -F'\t' '$1 == "extra"' | pick "要加進清單的 skill（這台已安裝）")
        [ -n "$chosen" ] || continue
        # fzf 結束時會清掉自己的畫面，先印出選了什麼，捲動紀錄才看得到
        echo "== add：$(printf '%s\n' "$chosen" | wc -l | tr -d ' ') 個 skill"
        printf '%s\n' "$chosen" | awk -F'\t' '{ printf "%-24s %s\n", $1, $2 }' >> "$LIST"
        echo "已加入清單："; printf '%s\n' "$chosen" | awk -F'\t' '{ print "  " $1 "  " $2 }'
        ;;
      install)
        chosen=$(states | awk -F'\t' '$1 == "missing"' | pick "要安裝的 skill（清單有、這台沒裝）")
        [ -n "$chosen" ] || continue
        echo "== install：$(printf '%s\n' "$chosen" | wc -l | tr -d ' ') 個 skill"
        printf '%s\n' "$chosen" | install_entries
        ;;
      remove)
        chosen=$(states | awk -F'\t' '$1 == "both" || $1 == "missing"' | pick "要從清單移除的 skill（不會從這台解除安裝）")
        [ -n "$chosen" ] || continue
        echo "== remove：$(printf '%s\n' "$chosen" | wc -l | tr -d ' ') 個 skill"
        # 保留註解與其他行，只刪掉選中的 skill
        awk 'FNR == NR { split($0, a, "\t"); rm[a[2]]; next }
             { line = $0; sub(/#.*/, "", line); split(line, f, " ") }
             !(f[2] in rm)' <(printf '%s\n' "$chosen") "$LIST" | write_list
        echo "已從清單移除："; printf '%s\n' "$chosen" | awk -F'\t' '{ print "  " $2 }'
        ;;
      *) break ;;
    esac
  done
  git -C "$(dirname "$(readlink -f "$LIST")")" diff --stat -- "$(readlink -f "$LIST")" 2>/dev/null || true
}

# fzf 預覽用：顯示 skill 的 SKILL.md 開頭，沒裝就顯示來源
cmd_preview() {
  local skill="$1" src="$2" f
  for f in "$SKILLS_DIR/$skill/SKILL.md" "$SKILLS_DIR/$skill/skills/$skill/SKILL.md"; do
    [ -f "$f" ] && { sed -n '1,40p' "$f"; return; }
  done
  echo "這台沒有安裝：$skill"
  echo "來源：$src"
}

case "${1:-}" in
  --preview) cmd_preview "$2" "$3" ;;
  --export) cmd_export ;;
  --diff) cmd_diff ;;
  --install) cmd_install ;;
  "")
    if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then
      need_list
      interactive
    else
      cmd_install
    fi
    ;;
  *)
    sed -n '2,16p' "$0"
    exit 1
    ;;
esac
