# shellcheck shell=bash
# ~/.tool.local 範本：只有這台機器才成立的工具設定（不進 repo）
# 用法：cp ~/.config/shell/tool.local.example ~/.tool.local，取消註解需要的段落
# 載入順序：env.sh → (oh-my-zsh) → tools.sh → functions.sh → aliases.sh → (~/.p10k.zsh) → ~/.tool.local → ~/.alias.local
# 所以這裡可以覆寫共用設定（例如 nvm 版本、PATH、p10k 選項）

# ================================================================ WSL
# --- X server
# NOTE: WSL 本機已由 env.sh 自動設 DISPLAY=:0 與 LIBGL_ALWAYS_INDIRECT=1，這裡只在要改用其他 X server 時覆寫
#       遠端 server 不要設，ssh -Y / -X 會自動帶入 DISPLAY
# WSL1 (kitty and xterm etc can use)
# export DISPLAY=127.0.0.1:0
# WSL2 + Windows 端 X server（VcXsrv 等）
# export DISPLAY=$(awk '/nameserver / {print $2; exit}' /etc/resolv.conf 2>/dev/null):0.0
# export XDG_RUNTIME_DIR=/run/user/$(id -u)

# --- Windows 程式
# PATH=/mnt/c/Program\ Files\ \(x86\)/Notepad++/:$PATH
# export PATH=$PATH:/mnt/c/Program\ Files/Notepad++
# alias npp="notepad++.exe"
# alias open="/mnt/c/AP/Anaconda3/Scripts/open.exe"
# alias pbcopy='clip.exe'
# alias pbpaste="powershell.exe -command 'Get-Clipboard' | tr -d '\r' | head -n -1"
# alias wterm="~/WezTerm-20221119-145034-49b9839f-Ubuntu18.04.AppImage"
# export BROWSER="/usr/bin/firefox"
# # export BROWSER="/mnt/c/chrome.exe"

# --- 其他這台才有的路徑
# export LD_LIBRARY_PATH=/lib:$LD_LIBRARY_PATH
# PATH=$PATH:$HOME/bin/lsix
# export R_HOME="/usr/sbin/R"
# # x86_64-conda-linux-gnu-cc 為了在 R 上安裝 languageserver
# export PATH="$PATH:/usr/sbin/R"

