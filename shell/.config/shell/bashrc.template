# ~/.bashrc 範本：每台機器各自一份，不進 repo 同步
#   新機器沒有 ~/.bashrc 時 install.sh 會複製這份；之後 conda init、nvm、fzf 等安裝程式改的都是這台自己的檔
# 會同步的共用設定在 ~/.config/shell/：env.sh、tools.sh、functions.sh、aliases.sh（zsh 也載入同一套）
# 這台專屬：~/.tool.local（工具路徑）、~/.alias.local（lab ssh alias，含真實 IP）

# NOTE: Return early during non-interactive sessions (e.g., scp file transfer)
[[ $- == *i* ]] || return

# NOTE: DISPLAY 很重要（X11 視窗、剪貼簿、im-select 等都靠它）
#   由 ~/.config/shell/env.sh 自動處理：只在 WSL 本機（且不是 ssh 進來）設 DISPLAY=:0
#   遠端 server 不要在任何地方寫死 DISPLAY，ssh -Y / -X 會自動帶入，寫死會讓 X 轉發失效

SHELL=$0

for _f in env tools functions aliases; do
  [ -f ~/.config/shell/$_f.sh ] && . ~/.config/shell/$_f.sh
done
unset _f

