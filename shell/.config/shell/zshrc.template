# tmux 裡重新進入 base，避免沿用外層 shell 的 conda 環境
# [[ -z $TMUX ]] || conda deactivate; conda activate base

# 機器專屬設定最後載入，可覆寫上面所有東西（p10k 選項如 POWERLEVEL9K_INSTANT_PROMPT 也在這裡設）
[ -f ~/.tool.local ] && source ~/.tool.local
[ -f ~/.alias.local ] && source ~/.alias.local
