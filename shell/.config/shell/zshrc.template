# ~/.zshrc 範本：每台機器各自一份，不進 repo 同步
#   新機器沒有 ~/.zshrc 時 install.sh 會複製這份；之後 conda init、nvm、fzf 等安裝程式改的都是這台自己的檔
# 會同步的共用設定在 ~/.config/shell/：
#   env.sh（PATH / EDITOR / DISPLAY）、omz.zsh（oh-my-zsh）、tools.sh、functions.sh、aliases.sh
# 這台專屬：~/.tool.local（工具路徑、p10k 選項）、~/.alias.local（lab ssh alias，含真實 IP）

# NOTE: Set cursor style to blinking beam
printf '\033[5 q'

# NOTE: DISPLAY 很重要（X11 視窗、剪貼簿、im-select 等都靠它）
#   由 ~/.config/shell/env.sh 自動處理：只在 WSL 本機（且不是 ssh 進來）設 DISPLAY=:0
#   遠端 server 不要在任何地方寫死 DISPLAY，ssh -Y / -X 會自動帶入，寫死會讓 X 轉發失效

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

shell_name=$(ps -p $$ -o comm=)
SHELL=$shell_name

# NOTE: PATH / EDITOR 先設好，oh-my-zsh 的 plugin 才找得到 ~/bin 裡的工具
[ -f ~/.config/shell/env.sh ] && source ~/.config/shell/env.sh
[ -f ~/.config/shell/omz.zsh ] && source ~/.config/shell/omz.zsh

for _f in tools functions aliases; do
  [ -f ~/.config/shell/$_f.sh ] && source ~/.config/shell/$_f.sh
done
unset _f

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

