{
  "$schema": "https://opencode.ai/config.json",
  "keybinds": {
    "input_paste": "alt+v"
  },
  "plugin": [
    "@slkiser/opencode-quota",
    "opencode-ralph-loop",
    "opencode-handoff"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "agent": {
    "opencodezen": {
      "mode": "primary",
      "model": "opencode/deepseek-v4-flash-free",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.4",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "autoupdate": "notify"
}
